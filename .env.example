# Solo desarrollo local. Nunca reutilizar en otros entornos.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=modular_commerce
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_MIGRATOR_PASSWORD=dev-migrator
DATABASE_APP_PASSWORD=dev-app
DATABASE_AUTH_PASSWORD=dev-auth
DATABASE_OPS_PASSWORD=dev-ops
AUTH_SECRET=dev-only-secret-change-me-32chars-min
# URL pública del panel: los enlaces de verificación y la cookie pasan por su proxy /api/auth
AUTH_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Cadena de confianza de IP (límite de intentos). Ver docs/DEPLOYMENT.md §Cadena de confianza.
# API: dirección del servidor del panel, que es quien le reenvía las peticiones. Vacío = API expuesta sin proxy.
TRUST_PROXY=127.0.0.1
# Panel: proxies delante del panel (balanceador, CDN), separados por comas, IP o CIDR. Vacío = el panel es el borde.
PANEL_TRUST_PROXY=
